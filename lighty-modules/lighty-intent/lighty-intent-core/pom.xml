<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lighty.core</groupId>
        <artifactId>lighty-parent</artifactId>
        <version>23.0.0-SNAPSHOT</version>
        <relativePath>../../../lighty-core/lighty-parent/pom.xml</relativePath>
    </parent>

    <groupId>io.lighty.modules.intent</groupId>
    <artifactId>lighty-intent-core</artifactId>
    <version>23.0.0-SNAPSHOT</version>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        Orchestrator for lighty.io's intent-driven management module: IntentLightyModule
        listens for intents written to the CONFIG datastore, validates and conflict-checks
        them, dispatches them to the registered IntentCompiler/DomainActuator for their
        domain, drives the intent lifecycle state machine, and implements the translate-nl,
        dry-run, approve-intent and reject-intent RPCs. Domain-agnostic: it depends only on
        lighty-intent-api and lighty-intent-models, never on a specific domain module.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-api</artifactId>
            <version>23.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.models.intent</groupId>
            <artifactId>lighty-intent-models</artifactId>
            <version>23.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.core</groupId>
            <artifactId>lighty-controller</artifactId>
            <version>23.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.opendaylight.mdsal</groupId>
            <artifactId>mdsal-binding-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.opendaylight.mdsal</groupId>
            <artifactId>mdsal-common-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lighty.resources</groupId>
            <artifactId>singlenode-configuration</artifactId>
            <version>23.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                lighty-parent's own dependencies put TestNG on every module's test classpath,
                which makes maven-surefire-plugin auto-detect the TestNG provider and silently
                run zero tests (as an empty TestNG suite) instead of this module's JUnit 4
                tests. Pinning the JUnit 4 provider here makes surefire actually run them.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit4</artifactId>
                        <version>3.5.3</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
