<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lighty.core</groupId>
        <artifactId>lighty-parent</artifactId>
        <version>23.0.0-SNAPSHOT</version>
        <relativePath>../../../lighty-core/lighty-parent/pom.xml</relativePath>
    </parent>

    <groupId>io.lighty.applications.intent</groupId>
    <artifactId>lighty-intent-module</artifactId>
    <version>23.0.0-SNAPSHOT</version>

    <name>${project.groupId}:${project.artifactId}</name>
    <url>https://github.com/PANTHEONtech/lighty</url>
    <description>
        AbstractLightyModule wiring (IntentAppModule) that assembles a LightyController,
        CommunityRestConf (RESTCONF NB) and lighty-intent-core's IntentLightyModule, together
        with the transport (gNMI-actuated) and RAN CCO (dry-run only) domain compilers and the
        NL-to-intent translator chain, into one runnable intent-driven-management application.
        See docs/intent-driven-management.md.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.lighty.core</groupId>
            <artifactId>lighty-controller</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules</groupId>
            <artifactId>lighty-restconf-nb-community</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lighty.applications</groupId>
            <artifactId>lighty-app-modules-config</artifactId>
        </dependency>

        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-transport</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-ran</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.intent</groupId>
            <artifactId>lighty-intent-nl-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lighty.models.intent</groupId>
            <artifactId>lighty-intent-models</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.lighty.modules.gnmi</groupId>
            <artifactId>lighty-gnmi-connector</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.gnmi.southbound</groupId>
            <artifactId>lighty-gnmi-sb</artifactId>
        </dependency>

        <dependency>
            <groupId>io.lighty.resources</groupId>
            <artifactId>singlenode-configuration</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-subclass</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lighty.modules.gnmi</groupId>
            <artifactId>lighty-gnmi-device-simulator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        All tests in this module are plain JUnit 5 (org.junit.jupiter), named "*Test.java" -
        maven-surefire-plugin's default include pattern already picks these up via the JUnit
        Platform provider it auto-selects when junit-jupiter-engine is on the classpath, so
        (unlike lighty-intent-core/-ran, which use JUnit 4 and need the surefire-junit4
        provider pinned to avoid lighty-parent's TestNG dependency hijacking the JUnit 4
        provider selection) no extra surefire configuration is needed here.
    -->

</project>
